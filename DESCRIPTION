Package: AudiomothR
Title: Acoustic Processing of 'AudioMoth' Recordings with 'BirdNET'
Version: 0.3.0
Authors@R: c(
    person("Antonio", "Canepa-Oneto", role = c("aut", "cre"),
           email = "ajcanepa@gmail.com"),
    person("Patricia", "de la Fuente Gamero", role = "aut"),
    person("José Antonio", "Barbero-Aparicio", role = "aut"),
